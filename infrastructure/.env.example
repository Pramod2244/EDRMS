# -----------------------------------------------------------------------------
# EDRMS - Environment Configuration Template
# All settings are environment-driven. DO NOT hardcode sensitive credentials.
# -----------------------------------------------------------------------------

# --- PostgreSQL Database ---
POSTGRES_DB=edrms
POSTGRES_USER=edrms_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_PORT=5432
KEYCLOAK_DB=keycloak

# --- Redis Cache & Queue ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_redis_password

# --- Keycloak Identity Provider ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_keycloak_admin_password
KEYCLOAK_REALM=edrms
KEYCLOAK_CLIENT_ID=edrms-web
KEYCLOAK_CLIENT_SECRET=replace_with_client_secret
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080

# --- OpenSearch Engine ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_NAME=edrms_documents
OPENSEARCH_DASHBOARDS_PORT=5601

# --- Storage Configuration ---
# Options: LOCAL | S3
STORAGE_ACTIVE_PROVIDER=LOCAL
STORAGE_LOCAL_ROOT_PATH=/var/data/edrms/storage

# --- AWS S3 & Textract OCR (Required if using S3 or AWS Textract) ---
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=edrms-documents-bucket
AWS_ACCESS_KEY_ID=replace_with_aws_access_key
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_key
AWS_S3_ENDPOINT_URL=

# --- Document Processing Pipeline ---
OCR_ACTIVE_ENGINE=AWS_TEXTRACT
PIPELINE_MAX_CONCURRENT_TASKS=4
LIBREOFFICE_BINARY_PATH=/usr/bin/soffice

# --- Application Server ---
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
JWT_ISSUER_URI=http://localhost:8080/realms/edrms
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Next.js App ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=edrms
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=edrms-web
NEXT_PUBLIC_SCANNER_AGENT_URL=ws://127.0.0.1:42100
